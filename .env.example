# Get a free Gemini API key at: https://aistudio.google.com/apikey
# Single key:
GEMINI_API_KEY=
# Or multiple keys (comma-separated) — used in order, and automatically
# rolled over to the next one when a key hits its free-tier quota limit.
# If set, this takes precedence over GEMINI_API_KEY above.
# GEMINI_API_KEYS=key1,key2,key3
